[Unit]
Description=Superdator inference server (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/gustav/superdator-inference/server
ExecStart=/home/gustav/superdator-inference/server/.venv/bin/python3 main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
